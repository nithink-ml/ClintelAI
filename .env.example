# ==============================================================================
# ClintelAI Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Never commit .env with real credentials or API keys to source control.
# ==============================================================================

# --- Application Core ---
PROJECT_NAME="ClintelAI"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="insecure-dev-secret-key-change-me-in-production-minimum-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# --- Database & Storage ---
POSTGRES_PORT=5433
POSTGRES_USER="clintelai"
POSTGRES_PASSWORD="clintelai_password"
POSTGRES_DB="clintelai_db"
# Connection URL when connecting from host machine (mapped to port 5433 by default):
DATABASE_URL="postgresql+asyncpg://clintelai:clintelai_password@localhost:5433/clintelai_db"
# Fallback local SQLite URL if PostgreSQL is not active during local development:
DATABASE_FALLBACK_URL="sqlite+aiosqlite:///./clintelai_dev.db"

# --- Redis Cache & Rate Limiting ---
REDIS_PORT=6380
REDIS_URL="redis://localhost:6380/0"
REDIS_FALLBACK_IN_MEMORY=true

# --- Vector Database ---
VECTOR_DB_TYPE="chroma"
CHROMA_PERSIST_DIR="./chroma_data"
CHROMA_HOST="localhost"
CHROMA_PORT=8001

# --- AI & RAG Configuration ---
# Options: 'gemini', 'openai', 'mock' (mock mode allows running offline without external API keys)
LLM_PROVIDER="mock"
# Fallback to mock when primary provider is unavailable (must be false in production)
LLM_FALLBACK_ENABLED=false
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# HuggingFace Embedding & Cross-Encoder Reranker models (local CPU/GPU)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
RAG_SIMILARITY_THRESHOLD=0.45
RAG_MAX_EVIDENCE_CHUNKS=4

# --- Maps & Provider Discovery ---
# Options: 'osm' (OpenStreetMap/Nominatim - free), 'mapbox', 'google'
MAPS_PROVIDER="osm"
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# --- Frontend Environment Variables ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
