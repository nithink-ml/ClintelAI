# ==============================================================================
# ClintelAI Production Environment Configuration (.env.production.example)
# ==============================================================================
# COPY THIS FILE TO .env.production AND CONFIGURE WITH SECURE, PRODUCTION SECRETS.
# DO NOT COMMIT PRODUCTION .env FILES CONTAINING ACTUAL CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# --- System & Deployment Environment ---
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="ClintelAI"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# --- Security, Authentication & Session Tokens ---
# Generate with: openssl rand -hex 32 (minimum 32 characters, cryptographically random)
SECRET_KEY="REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_SECRET_AT_LEAST_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cross-Origin Resource Sharing (CORS) ---
# MUST be explicit HTTPS origins in production. Wildcards ('*') are strictly rejected.
CORS_ORIGINS='["https://clintelai.example.com", "https://api.clintelai.example.com"]'

# --- PostgreSQL PostGIS Spatial Database ---
POSTGRES_USER="clintelai_app"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_DATABASE_PASSWORD"
POSTGRES_DB="clintelai_prod_db"
DATABASE_URL="postgresql+asyncpg://clintelai_app:REPLACE_WITH_STRONG_DATABASE_PASSWORD@postgres:5432/clintelai_prod_db"

# Connection Pool Tuning
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Redis Cache & Abuse Protection ---
REDIS_PASSWORD="REPLACE_WITH_STRONG_REDIS_PASSWORD"
REDIS_URL="redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis:6379/0"
REDIS_FALLBACK_IN_MEMORY=false

# --- Vector Database (ChromaDB) ---
VECTOR_DB_TYPE="chroma"
CHROMA_PERSIST_DIR="/chroma/chroma"
CHROMA_HOST="chromadb"
CHROMA_PORT=8000

# --- Clinical Generative AI (Google Gemini) ---
# Primary provider: 'gemini' for production generative synthesis with strict citation grounding
LLM_PROVIDER="gemini"
# Production safety constraint: MUST be false to prevent silent mock substitutions
LLM_FALLBACK_ENABLED=false
# Gemini Generative Language API Key (Keep strictly confidential)
GEMINI_API_KEY="REPLACE_WITH_VALID_GOOGLE_GEMINI_API_KEY"

# Embedding & Cross-Encoder Models (HuggingFace Clinical / MiniLM)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
RAG_SIMILARITY_THRESHOLD=0.45
RAG_MAX_EVIDENCE_CHUNKS=4

# --- API Rate Limiting & Abuse Prevention ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_RAG_PER_MINUTE=30

# --- Geospatial & Maps ---
# 'osm' (OpenStreetMap/Leaflet - Default, privacy-safe, no external keys required)
MAPS_PROVIDER="osm"
MAPBOX_ACCESS_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# --- Data Seeding Controls ---
# MUST be false in production to prevent synthetic demo facilities/alerts from auto-seeding
SEED_DEMO_DATA=false

# --- Frontend Application ---
NODE_ENV=production
NEXT_PUBLIC_API_URL="/api/v1"
NEXT_PUBLIC_DEFAULT_LOCALE="en"
NEXT_PUBLIC_ENABLE_DEMO_DATA=false
